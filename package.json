{
  "name": "deskling",
  "version": "0.0.1",
  "private": true,
  "description": "A bounded macOS desktop creature experiment",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "icons": "npm run build && electron . --icon-test",
    "prepare:icons": "node scripts/prepare-icons.cjs",
    "test": "npm run build && node --test dist/icon-probe.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "typescript": "7.0.2"
  }
}
